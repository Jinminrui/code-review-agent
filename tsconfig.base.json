{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "paths": {
      "@app/review-backend": ["./packages/review-backend/src/index.ts"],
      "@app/review-contracts": ["./packages/review-contracts/src/index.ts"],
      "@app/review-engine": ["./packages/review-engine/src/index.ts"],
      "@app/review-infrastructure": ["./packages/review-infrastructure/src/index.ts"]
    },
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "noUncheckedIndexedAccess": true
  }
}
